OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
DB_PATH=data/cinerocket.db

# Opcional: "off" desliga a chamada extra de schema linking (economiza 1 req/pergunta)
# SCHEMA_LINKING=on

# Opcional: provedor reserva. Com a chave (grátis em console.groq.com/keys), os
# modelos do Groq entram no fim da cadeia, depois dos ":free" do OpenRouter.
# GROQ_API_KEY=
# GROQ_MODELS=qwen/qwen3.8-27b

# Opcional: troca a ordem/lista de modelos do OpenRouter sem mexer no código.
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free

# Opcional: "off" desliga a checagem da cadeia contra o catálogo do OpenRouter
# ao iniciar (chamada pública, não consome cota).
# MODEL_CATALOG_CHECK=on
